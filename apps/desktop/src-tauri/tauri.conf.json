{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strategy War Remaster",
  "version": "../package.json",
  "identifier": "com.apachey.strategywarremaster",
  "build": {
    "beforeDevCommand": "pnpm --filter @sw/game dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @sw/game build",
    "frontendDist": "../../game/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Strategy War Remaster",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.strategy-games",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
