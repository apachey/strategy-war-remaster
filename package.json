{
  "name": "strategy-war-remaster",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sw/game dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @sw/game e2e",
    "desktop:dev": "pnpm --filter @sw/desktop tauri dev",
    "desktop:build": "pnpm --filter @sw/desktop tauri build",
    "extract": "node tools/extract/extract-campaign.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
